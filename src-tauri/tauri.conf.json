{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polyglot",
  "version": "0.2.0",
  "identifier": "com.polyglot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Polyglot",
        "width": 780,
        "height": 560,
        "minWidth": 600,
        "minHeight": 440,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFERkQ2QUExNTBBQTk2QUQKUldTdGxxcFFvV3I5clI0S09sa0RLYUVPdExHSk85b2FUTHYxT0RVanAvQ05UbG9JWnZqUGVDSTgK",
      "endpoints": [
        "https://github.com/Luth-infinity/polyglot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
